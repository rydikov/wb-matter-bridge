{
  "name": "wb-matter-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "WB_MATTER_DATA=./data WB_MATTER_STORAGE_PATH=./data/runtime/matter WB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 tsx watch src/server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "npm run build:web && tsc -p tsconfig.server.json",
    "build:web": "vite build --config vite.config.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --root .",
    "test:watch": "vitest --root ."
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@matter/main": "0.17.9",
    "@matter/nodejs": "0.17.9",
    "ajv": "8.20.0",
    "fastify": "5.12.1",
    "mqtt": "5.15.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
